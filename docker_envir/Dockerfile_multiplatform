# Start with the GCC base image
FROM gcc:14.3.0

# Add metadata about the image
LABEL maintainer="CJH-James <qaz75203code@gmail.com>"
LABEL description="Minimal Docker image for C development with GCC-14.3.0 and CMake-3.31.12."

# ARG to specify platform during build
# p.s. Do NOT give the default value, or it will build fail
ARG TARGETPLATFORM

# ARG for the user permission
ARG USER_NAME=developer
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG WORKDIR=/workspace
ARG INSTALL_DEBUG=false

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Install required tools and dependencies
# wget & ca-certificates --> for install cmake from web source
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        wget \  
        ca-certificates \
        sudo && \
    rm -rf /var/lib/apt/lists/*

# Install Debug tools
RUN if [ "$INSTALL_DEBUG" = "true" ]; then \
    apt-get update && apt-get install -y --no-install-recommends \
    gdb gdbserver valgrind && \
    rm -rf /var/lib/apt/lists/*; \
    fi

# Install CMake using precompiled binaries
RUN case "$TARGETPLATFORM" in \
    "linux/amd64") \
        wget https://github.com/Kitware/CMake/releases/download/v3.31.12/cmake-3.31.12-linux-x86_64.sh -O /tmp/cmake.sh; \
        ;; \
    "linux/arm64") \
        wget https://github.com/Kitware/CMake/releases/download/v3.31.12/cmake-3.31.12-linux-aarch64.sh -O /tmp/cmake.sh; \
        ;; \
    *) \
        echo "Unsupported platform: $TARGETPLATFORM"; \
        apt install cmake -y \
        exit 1 ;; \
    esac && \
    chmod +x /tmp/cmake.sh && \
    /tmp/cmake.sh --skip-license --prefix=/usr/local && \
    rm /tmp/cmake.sh


# Set the user permission
RUN addgroup --gid $GROUP_ID $USER_NAME
RUN adduser --disabled-password --gecos '' --uid $USER_ID --gid $GROUP_ID $USER_NAME
# Give the $USER_NAME user sudo privileges
RUN echo "$USER_NAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
# switch to the user "$USER_NAME"
USER $USER_NAME

WORKDIR $WORKDIR

# Default command
CMD ["bash"]
